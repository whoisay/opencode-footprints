{
  "name": "opencode-user-timeline",
  "version": "0.2.0",
  "description": "OpenCode 2 TUI 插件：在会话侧边栏显示用户消息时间线，支持滚轮浏览与点击跳转定位。Sidebar timeline of your messages with scroll & click-to-jump.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/huahai0202/opencode-user-timeline.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode2",
    "tui"
  ],
  "engines": {
    "opencode": ">=2.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "babel src --out-dir dist --extensions .ts,.tsx",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/client": "0.0.0-beta-18866",
    "@opencode-ai/plugin": "0.0.0-beta-18866"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@types/node": "^26.0.1",
    "babel-preset-solid": "^1.9.15",
    "solid-js": "^1.9.15",
    "typescript": "^6.0.3"
  }
}
