{
  "name": "opencode-footprints",
  "version": "1.0.4",
  "description": "侧边栏「足迹」：当前会话的用户提问时间线，支持点击跳转、按日期切换、跟随当前视口、悬停预览。",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whoisay/opencode-footprints.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode2",
    "tui",
    "timeline",
    "footprints"
  ],
  "engines": {
    "opencode": ">=2.0.2"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "babel src --out-dir dist --extensions .ts,.tsx",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "verify": "tsc --noEmit && babel src --out-dir dist --extensions .ts,.tsx && node --test \"test/*.test.mjs\"",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@opencode/client": "2.0.32",
    "@opencode/plugin": "2.0.32"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.27.1",
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "@types/node": "^26.0.1",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.12",
    "typescript": "^6.0.3"
  },
  "homepage": "https://github.com/whoisay/opencode-footprints#readme",
  "bugs": {
    "url": "https://github.com/whoisay/opencode-footprints/issues"
  },
  "author": "whoisay"
}
